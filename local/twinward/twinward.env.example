# Twinward local FreeLLMAPI settings for OVERKILL (Selah/Thaylor).
# No secrets in this file. It is safe to commit.
# To add a free-cloud key later, copy this file to twinward.env (gitignored),
# and add keys on the dashboard (stored encrypted in the DB outside the repo),
# never here.

# Localhost only. Nothing on the LAN or internet can reach it.
HOST=127.0.0.1
PORT=3001
ALLOWED_HOSTS=localhost

# Data lives outside the repo (DB + auto-generated .encryption-key next to it).
# Not D:\thaylor-runtime and not H:\thaylor\memory (learner data).
FREEAPI_DB_PATH=C:\Users\Drex\freellmapi-data\freellmapi.db
FREEAPI_DB_DIR_HARDENING=1

# Ollama on this PC, added as a custom OpenAI-compatible provider. Ollama ignores
# the key; the config uses the placeholder 'ollama' because the field is required.
FREEAPI_CONFIG_PATH=C:\Users\Drex\source\repos\freellmapi\local\twinward\freellmapi.config.example.json
PROVIDER_TIMEOUT_CUSTOM=240000

# Stay quiet: no catalog pull, no update checks, no background probes.
CATALOG_SYNC_DISABLED=1
FREELLMAPI_UPDATE_CHECK=off

# China-origin block (lib/origin-block.ts). Platforms are exact ids; model
# patterns are case-insensitive substrings of the model id.
FREELLMAPI_BLOCKED_PLATFORMS=zhipu,modelscope,siliconflow,qianfan,volcengine,longcat,xfyun,moonshot,minimax,radeon
FREELLMAPI_BLOCKED_MODEL_PATTERNS=qwen,qwq,deepseek,glm,chatglm,codegeex,kimi,moonshot,baichuan,yi-,01-ai,minimax,abab,hunyuan,ernie,doubao,seed-oss,spark,internlm,intern-,stepfun,step-,longcat,mimo,inclusionai,ling-,ring-,kat-coder,sensenova,skywork,xverse,telechat,pangu,cogito-2.1,big-pickle,owl-alpha,novita